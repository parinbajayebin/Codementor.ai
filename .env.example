# ===========================================
# CodeMentor AI - Environment Variables
# ===========================================

# OpenRouter API Key
# Used by: backend/app/services/llm_service.py
# Purpose: Authenticate with OpenRouter to access Qwen LLM for answer generation
# How to get: Sign up at https://openrouter.ai/, go to Keys, create a new key
OPENROUTER_API_KEY=

# Qdrant Cloud URL
# Used by: backend/app/services/vector_service.py
# Purpose: Connect to Qdrant Cloud for storing and searching code embeddings
# How to get: Sign up at https://cloud.qdrant.io/, create a cluster, copy the URL
QDRANT_URL=

# Qdrant API Key
# Used by: backend/app/services/vector_service.py
# Purpose: Authenticate with Qdrant Cloud cluster
# How to get: In Qdrant Cloud dashboard, go to your cluster -> API Keys
QDRANT_API_KEY=

# HuggingFace Token (Optional)
# Used by: backend/app/services/embedding_service.py
# Purpose: Download BAAI/bge-small-en-v1.5 embedding model (public model, token optional)
# How to get: Sign up at https://huggingface.co/, go to Settings -> Access Tokens
HF_TOKEN=

# Redis URL
# Used by: backend/app/utils/cache.py
# Purpose: Cache repo status, chat answers, and embeddings to reduce API calls and speed up responses
# How to get: Use local Redis (redis://localhost:6379) or a free cloud instance from https://redis.io/try-free/
REDIS_URL=redis://localhost:6379
